# =========================
# Telegram bot token
# =========================
TOKEN=YOUR_TELEGRAM_BOT_TOKEN

# =========================
# Cookies mode
# =========================
# COOKIES_ENABLED:
#   true  - use cookies file (requires COOKIES_PATH)
#   false - no cookies
COOKIES_ENABLED=false

# COOKIES_PATH:
#   Path to cookies.txt exported in Netscape format (what yt-dlp expects for --cookies).
#   Example:
#     COOKIES_PATH=/opt/bot/cookies.txt
COOKIES_PATH=

# =========================
# BGUtil POT provider
# =========================
# POT_PROVIDER:
#   true  - enable bgutil POT provider (requires plugin + service)
#   false - disabled
#
# Notes:
#   - Install plugin: pip install bgutil-ytdlp-pot-provider
#   - Run service:
#       docker run --name bgutil-provider -d --init -p 4416:4416 brainicism/bgutil-ytdlp-pot-provider:latest
POT_PROVIDER=false

# =========================
# JS Runtime for yt-dlp EJS flow
# =========================
# JS_RUNTIME:
#   Path to JS runtime executable for yt-dlp's EJS execution flow.
#   Format: <name>:<path> or just <name> (looked up in PATH).
#   Examples:
#     JS_RUNTIME=node
#     JS_RUNTIME=node:/usr/bin/node
#   Leave empty to disable JS runtime usage.
JS_RUNTIME=

# =========================
# Rate limit (for premium downloads)
# =========================
# RATE_LIMIT:
#   Per-user cooldown for PREMIUM downloads (only when COOKIES_ENABLED=true).
#   Value is in SECONDS. Example:
#     RATE_LIMIT=60   # one premium download per minute per user
#   Set 0 to disable:
#     RATE_LIMIT=0
RATE_LIMIT=0
